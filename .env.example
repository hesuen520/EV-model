# Copy to .env (git-ignored) and export, or set these in your shell.
# Nothing here is required for the core platform: public datasets need no key.

# Optional paths
# SPORTSPRED_CONFIG=examples/sportspred.toml
# SPORTSPRED_DATA_DIR=data
# SPORTSPRED_OFFLINE=1            # never touch the network; use cached files only

# Optional EV module price feeds (only if you use them; paper tracking only)
# ODDS_API_KEY=
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=
